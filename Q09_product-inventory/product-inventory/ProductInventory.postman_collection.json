			"name": "1 - CREATE Product (Laptop)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Laptop\",\n  \"category\": \"Electronics\",\n  \"price\": 55000.00,\n  \"quantity\": 10,\n  \"description\": \"Dell Inspiron 15 - Intel i5\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8080/api/products",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "products"]
				},
				"description": "Creates a new product.\nExpected: 201 Created\nReturns the saved product with auto-generated MongoDB ID.\n\nCOPY the 'id' from response to use in GET/PUT/DELETE requests below!"
			}
		},
