		{
			"name": "4 - GET All Products",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/products",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "products"]
				},
