{
	"info": {
		"_postman_id": "product-inventory-collection",
		"name": "Product Inventory API",
		"description": "Complete CRUD operations for Product Inventory Management System\nSpring Boot + MongoDB + Basic Auth\n\nCredentials:\n- Admin: admin / admin123\n- User:  user / user123",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "admin",
				"type": "string"
			},
			{
				"key": "password",
				"value": "admin123",
				"type": "string"
			}
		]
	},
	"item": [
