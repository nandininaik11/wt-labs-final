<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    POM.XML - Project Object Model file for Maven build tool
    This file defines project dependencies, plugins, and build configuration
    Maven is a build automation and dependency management tool for Java
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <!-- Maven POM model version (always 4.0.0 for Maven 2 & 3) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 
        Parent POM: spring-boot-starter-parent
        Provides default configurations, dependency management, and plugin management
        Inheriting from this parent makes Spring Boot setup much easier
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version> <!-- Spring Boot version -->
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- 
        Project Coordinates (GAV)
        groupId: Unique identifier for your organization/project group
        artifactId: Name of your project/application
        version: Current version of your application
    -->
    <groupId>com.ordermanagement</groupId>
    <artifactId>order-management-system</artifactId>
    <version>1.0.0</version>
    
    <!-- Project name and description -->
    <name>Order Management System</name>
    <description>REST API based Order Management System using Spring Boot</description>

    <!-- 
        Properties Section
        Defines variables used throughout the POM
        Java version specification is crucial for compatibility
    -->
    <properties>
        <java.version>17</java.version> <!-- Java 17 LTS version -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- 
        Dependencies Section
        Lists all libraries/frameworks needed by the application
        Maven automatically downloads these from Maven Central Repository
    -->
    <dependencies>
        
        <!-- 
            Spring Boot Web Starter
            Includes: Spring MVC, REST, Tomcat (embedded server), Jackson (JSON)
            This is the core dependency for building REST APIs
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 
            Spring Boot Data JPA Starter
            Includes: Hibernate (ORM), Spring Data JPA, Jakarta Persistence API
            Used for database operations with object-relational mapping
            Simplifies database CRUD operations
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 
            H2 Database
            In-memory database (data stored in RAM, lost on restart)
            Perfect for development and testing
            No installation needed - embedded database
            Scope: runtime means it's only needed when running, not for compilation
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 
            Spring Boot DevTools
            Provides: automatic restart, live reload, configurations
            Improves development experience
            Scope: optional means it won't be included in production builds
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- 
            Lombok
            Reduces boilerplate code using annotations
            Auto-generates: getters, setters, constructors, toString, etc.
            Scope: provided means it's only needed at compile time
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 
            Spring Boot Validation Starter
            Provides: Bean Validation (JSR-380) using Hibernate Validator
            Used for input validation in REST APIs (@NotNull, @NotBlank, etc.)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 
            Spring Boot Test Starter
            Includes: JUnit, Spring Test, Mockito, AssertJ
            Scope: test means it's only used for testing, not in production
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- 
        Build Section
        Defines how the project should be built
    -->
    <build>
        <plugins>
            <!-- 
                Spring Boot Maven Plugin
                Packages the application as an executable JAR
                Allows running with: mvn spring-boot:run
                Creates fat/uber JAR with all dependencies included
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Exclude Lombok from final JAR (only needed at compile time) -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
